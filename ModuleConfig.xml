<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Reduced Hyperdrive Fuel Costs</moduleName>
  <installSteps order="Explicit">
    <installStep name="Choose warps per warp cell">
      <optionalFileGroups order="Explicit">
        <group name="Hyperdrive Fuel" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Double">
              <description>2x warps per cell - each hyperdrive jump costs half as many Warp Cells</description>
              <files>
                <folder source="Double" destination="Reduced Hyperdrive Fuel Costs - Double" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Quadruple">
              <description>4x warps per cell - a quarter of the normal Warp Cell cost per jump</description>
              <files>
                <folder source="Quadruple" destination="Reduced Hyperdrive Fuel Costs - Quadruple" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Tenfold">
              <description>10x warps per cell - galactic travel for a tenth of the fuel</description>
              <files>
                <folder source="Tenfold" destination="Reduced Hyperdrive Fuel Costs - Tenfold" priority="0" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
